{
    "name": "danielpetrica/authmd-for-laravel",
    "description": "auth.md for Laravel — Open protocol for AI agent user registration",
    "keywords": ["laravel", "auth", "agent", "auth.md", "mcp", "oauth"],
    "license": "MIT",
    "authors": [
        {
            "name": "Daniel Petrica",
            "email": "hello@danielpetrica.com"
        }
    ],
    "require": {
        "php": "^8.5",
        "firebase/php-jwt": "^7.0",
        "illuminate/cache": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/routing": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^9.0|^10.0",
        "pestphp/pest": "^3.0",
        "phpstan/phpstan": "^2.0",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "DanielPetrica\\AuthMd\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "DanielPetrica\\AuthMd\\Database\\Factories\\": "database/factories/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "DanielPetrica\\AuthMd\\AuthMdServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "preferred-install": "dist",
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "lint": [
            "pint --parallel",
            "rector"
        ],
        "test:lint": [
            "pint --parallel --test",
            "rector --dry-run"
        ],
        "test:unit": "pest --parallel --coverage",
        "test:types": "phpstan",
        "test": [
            "@test:lint",
            "@test:types",
            "@test:unit"
        ]
    }
}
